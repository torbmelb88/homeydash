# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Dev-proxy (valgfritt) – lokale mål for vite dev-serverens proxier
# VITE_HOMEY_PROXY_TARGET=http://192.168.1.x
# VITE_MA_PROXY_TARGET=http://192.168.1.x:8095

# Sett til 1 for å bygge en versjon som starter i demo-modus (brukes av GitHub Pages)
# VITE_DEMO_DEFAULT=1
