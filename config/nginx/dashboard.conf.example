map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen 443 ssl;
    ssl_certificate     /etc/nginx/certs/dashboard.crt;
    ssl_certificate_key /etc/nginx/certs/dashboard.key;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 0;

    location /todoist-api/ {
        proxy_pass https://api.todoist.com/api/v1/;
        proxy_set_header Host api.todoist.com;
        proxy_set_header Authorization $http_authorization;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
    }

    location /todoist-sync/ {
        proxy_pass https://api.todoist.com/sync/v9/;
        proxy_set_header Host api.todoist.com;
        proxy_set_header Authorization $http_authorization;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
    }

    # Reverse-proxy Home Assistant so an HTTPS dashboard reaches HA over
    # same-origin wss:// (avoids mixed-content blocking of ws://...:8123).
    location /ha/ {
        proxy_pass http://HJEMMESERVER_IP:8123/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Same-origin proxies for local http services so the HTTPS dashboard can
    # reach them without mixed-content blocking. One location per port.
    location /svc/8989/ { proxy_pass http://HJEMMESERVER_IP:8989/; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_set_header Host $host; proxy_read_timeout 3600s; }
    location /svc/7878/ { proxy_pass http://HJEMMESERVER_IP:7878/; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_set_header Host $host; proxy_read_timeout 3600s; }
    location /svc/8093/ { proxy_pass http://HJEMMESERVER_IP:8093/; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_set_header Host $host; proxy_read_timeout 3600s; }
    location /svc/8085/ { proxy_pass http://HJEMMESERVER_IP:8085/; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_set_header Host $host; proxy_read_timeout 3600s; }
    location /svc/5000/ { proxy_pass http://HJEMMESERVER_IP:5000/; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_set_header Host $host; proxy_read_timeout 3600s; }
    location /svc/1984/ { proxy_pass http://HJEMMESERVER_IP:1984/; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_set_header Host $host; proxy_read_timeout 3600s; }
    location /svc/8095/ { proxy_pass http://HJEMMESERVER_IP:8095/; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; proxy_set_header Host $host; proxy_read_timeout 3600s; }

    # SPA cache strategy: hashed assets are immutable and cached forever,
    # but index.html must always revalidate so new deploys are picked up
    # immediately (no manual cache-clear in Fully Kiosk).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

